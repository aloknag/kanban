    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/expect": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
