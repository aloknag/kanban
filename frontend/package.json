    "@fontsource-variable/newsreader": "^5.0.0",
    "@tanstack/react-query": "^5.25.0",
    "lucide-react": "^0.395.0",
    "mermaid": "^10.6.0",
    "react": "^19.0.0-beta",
    "react-dom": "^19.0.0-beta",
    "react-hook-form": "^7.48.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.20.0",
